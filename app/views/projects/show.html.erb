<%= render "shared/progress_header" %>
<h1>專案詳細資料</h1>

<p>
  <strong>ID:</strong>
  <%= @project.id %>
</p>
<p>
  <strong>專案名稱:</strong>
  <%= @project.project_name %>
</p>
<p>
  <strong>工程類型:</strong>
  <%= @project.project_type_display %>
</p>
<p>
  <strong>工程位置:</strong>
  <%= @project.location %>
</p>

<% case @project.project_type_display %>
<% when "建築工程" %>
  <p>
    <strong>工程面積:</strong>
    <%= @project.formatted_measurement(@project.area, @project.area_unit) || "—" %>
  </p>
  <p>
    <strong>地上樓層:</strong>
    <%= @project.formatted_measurement(@project.above_ground_floors, @project.above_floor_unit) || "—" %>
  </p>
  <p>
    <strong>地下樓層:</strong>
    <%= @project.formatted_measurement(@project.below_ground_floors, @project.below_floor_unit) || "—" %>
  </p>
<% when "道路工程" %>
  <p>
    <strong>道路工程面積:</strong>
    <%= @project.formatted_measurement(@project.area, @project.area_unit) || "—" %>
  </p>
  <p>
    <strong>開挖深度:</strong>
    <%= @project.formatted_measurement(@project.excavation_depth, @project.depth_unit) || "—" %>
  </p>
<% when "下水道工程" %>
  <p>
    <strong>管線長度:</strong>
    <%= @project.formatted_measurement(@project.sewer_pipeline_length, @project.sewer_pipeline_length_unit) || "—" %>
  </p>
  <p>
    <strong>斷面積:</strong>
    <%= @project.formatted_measurement(@project.sewer_cross_section_area, @project.sewer_cross_section_area_unit) || "—" %>
  </p>
<% when "水利工程" %>
  <h5>護岸</h5>
  <ul>
    <li>長度：<%= @project.formatted_measurement(@project.hydraulic_revetment_length, @project.hydraulic_revetment_length_unit) || "—" %></li>
    <li>高度：<%= @project.formatted_measurement(@project.hydraulic_revetment_height, @project.hydraulic_revetment_height_unit) || "—" %></li>
    <li>厚度：<%= @project.formatted_measurement(@project.hydraulic_revetment_thickness, @project.hydraulic_revetment_thickness_unit) || "—" %></li>
  </ul>
  <h5>樁基礎</h5>
  <ul>
    <li>樁長：<%= @project.formatted_measurement(@project.hydraulic_pile_length, @project.hydraulic_pile_length_unit) || "—" %></li>
    <li>截面積：<%= @project.formatted_measurement(@project.hydraulic_pile_cross_section_area, @project.hydraulic_pile_cross_section_area_unit) || "—" %></li>
  </ul>
<% when "國道/公路工程" %>
  <h5>上部</h5>
  <ul>
    <li>面積：<%= @project.formatted_measurement(@project.highway_superstructure_area, @project.highway_superstructure_area_unit) || "—" %></li>
    <li>厚度：<%= @project.formatted_measurement(@project.highway_superstructure_thickness, @project.highway_superstructure_thickness_unit) || "—" %></li>
  </ul>
  <h5>橋墩</h5>
  <ul>
    <li>高度：<%= @project.formatted_measurement(@project.highway_pier_height, @project.highway_pier_height_unit) || "—" %></li>
    <li>截面積：<%= @project.formatted_measurement(@project.highway_pier_cross_section_area, @project.highway_pier_cross_section_area_unit) || "—" %></li>
  </ul>
  <h5>鋪面</h5>
  <ul>
    <li>面積：<%= @project.formatted_measurement(@project.highway_pavement_area, @project.highway_pavement_area_unit) || "—" %></li>
    <li>厚度：<%= @project.formatted_measurement(@project.highway_pavement_thickness, @project.highway_pavement_thickness_unit) || "—" %></li>
  </ul>
  <h5>路基</h5>
  <ul>
    <li>長度：<%= @project.formatted_measurement(@project.highway_subgrade_length, @project.highway_subgrade_length_unit) || "—" %></li>
    <li>斷面積：<%= @project.formatted_measurement(@project.highway_subgrade_cross_section_area, @project.highway_subgrade_cross_section_area_unit) || "—" %></li>
  </ul>
<% when "軌道工程" %>
  <p>
    <strong>軌道長度:</strong>
    <%= @project.formatted_measurement(@project.rail_track_length, @project.rail_track_length_unit) || "—" %>
  </p>
<% when "水保工程" %>
  <h5>坡面工</h5>
  <ul>
    <li>長度：<%= @project.formatted_measurement(@project.swc_slope_length, @project.swc_slope_length_unit) || "—" %></li>
    <li>高度：<%= @project.formatted_measurement(@project.swc_slope_height, @project.swc_slope_height_unit) || "—" %></li>
  </ul>
  <h5>籠工／石工</h5>
  <ul>
    <li>面積：<%= @project.formatted_measurement(@project.swc_gabion_area, @project.swc_gabion_area_unit) || "—" %></li>
  </ul>
<% else %>
  <p>此專案不需額外欄位</p>
<% end %>

<%= link_to "回到列表", projects_path %>
