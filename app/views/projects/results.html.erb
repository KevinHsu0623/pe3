<%= render "shared/progress_header" %>

<!-- 只需引入一次 Chart.js 與 DataLabels 插件 -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>

<div style="display: flex; justify-content: space-between; margin-bottom: 2rem;">
  <!-- 左側：碳排報表 -->
  <div style="flex: 1;">
    <h1>碳排放統計報表</h1>
    <p><strong>總碳排放量：</strong>
      <%= @total_emission && @total_emission > 0 ? "#{@total_emission.round(2)} kg CO2e" : "尚未輸入任何材料" %>
    </p>
    <p><strong>單位面積碳排：</strong>
      <%= @emission_per_area ? "#{@emission_per_area.round(2)} kg CO2e/㎡" : "尚未輸入工程面積" %>
    </p>
  </div>

  <!-- 右側：專案資訊 -->
  <div style="flex: 1; padding-left: 3rem;">
    <h2>專案資訊</h2>
    <ul>
      <li><strong>專案名稱：</strong> <%= @project.project_name %></li>
      <li><strong>工程類型：</strong> <%= @project.project_type_display %></li>
      <li><strong>工程位置：</strong> <%= @project.location %></li>
      <% case @project.project_type_display %>
      <% when "建築工程" %>
        <li><strong>工程面積：</strong> <%= @project.formatted_measurement(@project.area, @project.area_unit) || "—" %></li>
        <li><strong>地上樓層：</strong> <%= @project.formatted_measurement(@project.above_ground_floors, @project.above_floor_unit) || "—" %></li>
        <li><strong>地下樓層：</strong> <%= @project.formatted_measurement(@project.below_ground_floors, @project.below_floor_unit) || "—" %></li>
      <% when "道路工程" %>
        <li><strong>道路工程面積：</strong> <%= @project.formatted_measurement(@project.area, @project.area_unit) || "—" %></li>
        <li><strong>開挖深度：</strong> <%= @project.formatted_measurement(@project.excavation_depth, @project.depth_unit) || "—" %></li>
      <% when "下水道工程" %>
        <li><strong>管線長度：</strong> <%= @project.formatted_measurement(@project.sewer_pipeline_length, @project.sewer_pipeline_length_unit) || "—" %></li>
        <li><strong>斷面積：</strong> <%= @project.formatted_measurement(@project.sewer_cross_section_area, @project.sewer_cross_section_area_unit) || "—" %></li>
      <% when "水利工程" %>
        <li><strong>護岸長度：</strong> <%= @project.formatted_measurement(@project.hydraulic_revetment_length, @project.hydraulic_revetment_length_unit) || "—" %></li>
        <li><strong>護岸高度：</strong> <%= @project.formatted_measurement(@project.hydraulic_revetment_height, @project.hydraulic_revetment_height_unit) || "—" %></li>
        <li><strong>護岸厚度：</strong> <%= @project.formatted_measurement(@project.hydraulic_revetment_thickness, @project.hydraulic_revetment_thickness_unit) || "—" %></li>
        <li><strong>樁長：</strong> <%= @project.formatted_measurement(@project.hydraulic_pile_length, @project.hydraulic_pile_length_unit) || "—" %></li>
        <li><strong>樁截面積：</strong> <%= @project.formatted_measurement(@project.hydraulic_pile_cross_section_area, @project.hydraulic_pile_cross_section_area_unit) || "—" %></li>
      <% when "國道/公路工程" %>
        <li><strong>上部面積：</strong> <%= @project.formatted_measurement(@project.highway_superstructure_area, @project.highway_superstructure_area_unit) || "—" %></li>
        <li><strong>上部厚度：</strong> <%= @project.formatted_measurement(@project.highway_superstructure_thickness, @project.highway_superstructure_thickness_unit) || "—" %></li>
        <li><strong>橋墩高度：</strong> <%= @project.formatted_measurement(@project.highway_pier_height, @project.highway_pier_height_unit) || "—" %></li>
        <li><strong>橋墩截面積：</strong> <%= @project.formatted_measurement(@project.highway_pier_cross_section_area, @project.highway_pier_cross_section_area_unit) || "—" %></li>
        <li><strong>鋪面面積：</strong> <%= @project.formatted_measurement(@project.highway_pavement_area, @project.highway_pavement_area_unit) || "—" %></li>
        <li><strong>鋪面厚度：</strong> <%= @project.formatted_measurement(@project.highway_pavement_thickness, @project.highway_pavement_thickness_unit) || "—" %></li>
        <li><strong>路基長度：</strong> <%= @project.formatted_measurement(@project.highway_subgrade_length, @project.highway_subgrade_length_unit) || "—" %></li>
        <li><strong>路基斷面積：</strong> <%= @project.formatted_measurement(@project.highway_subgrade_cross_section_area, @project.highway_subgrade_cross_section_area_unit) || "—" %></li>
      <% when "軌道工程" %>
        <li><strong>軌道長度：</strong> <%= @project.formatted_measurement(@project.rail_track_length, @project.rail_track_length_unit) || "—" %></li>
      <% when "水保工程" %>
        <li><strong>坡面工長度：</strong> <%= @project.formatted_measurement(@project.swc_slope_length, @project.swc_slope_length_unit) || "—" %></li>
        <li><strong>坡面工高度：</strong> <%= @project.formatted_measurement(@project.swc_slope_height, @project.swc_slope_height_unit) || "—" %></li>
        <li><strong>籠工／石工面積：</strong> <%= @project.formatted_measurement(@project.swc_gabion_area, @project.swc_gabion_area_unit) || "—" %></li>
      <% end %>
    </ul>
  </div>
</div>

<h2>排放量前 5 名材料</h2>
<% if @top5.present? %>
  <table class="table table-bordered mb-4">
    <thead>
      <tr><th>材料</th><th>排放量 (kg CO2e)</th></tr>
    </thead>
    <tbody>
      <% @top5.each do |name, value| %>
        <tr>
          <td><%= name %></td>
          <td><%= value.round(2) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>尚無任何材料紀錄。</p>
<% end %>

<hr>

<h2>碳排佔比分析</h2>
<div class="row">
  <div class="col-md-6 mb-4">
    <h5>所有材料碳排占比</h5>
    <canvas id="combinedPieChart" width="500" height="500"></canvas>
  </div>
  <div class="col-md-6 mb-4">
    <h5>A1~A3 階段材料碳排占比</h5>
    <canvas id="a1a3-pie" width="300" height="300"></canvas>
  </div>
</div>
<div class="row">
  <div class="col-md-6 mb-4">
    <h5>A4~A5 階段材料碳排占比</h5>
    <canvas id="a4a5-pie" width="300" height="300"></canvas>
  </div>
  <div class="col-md-6 mb-4">
    <h5>各階段碳排在總排放中的占比</h5>
    <canvas id="stage-comparison-pie" width="300" height="300"></canvas>
  </div>
</div>

<script>
  const setupProjectCharts = () => {
    if (typeof Chart === "undefined" || typeof ChartDataLabels === "undefined") return;

    Chart.register(ChartDataLabels);

    const chartIds = ["combinedPieChart", "a1a3-pie", "a4a5-pie", "stage-comparison-pie"];
    chartIds.forEach((id) => {
      const existing = Chart.getChart(id);
      if (existing) existing.destroy();
    });

    const commonOptions = {
      plugins: {
        datalabels: {
          formatter: (value, ctx) => {
            const data = ctx.chart.data.datasets[0].data;
            const sum  = data.reduce((a, b) => a + b, 0);
            if (sum === 0) return "0%";
            return (value / sum * 100).toFixed(1) + "%";
          },
          color: "#fff",
          font: { weight: "bold", size: 14 },
          anchor: "center",
          align: "center",
          clip: false
        }
      }
    };

    const drawPie = (id, labels, data) => {
      const canvas = document.getElementById(id);
      if (!canvas) return;

      new Chart(canvas, {
        type: "pie",
        data: { labels, datasets: [{ data }] },
        options: commonOptions,
        plugins: [ChartDataLabels]
      });
    };

    drawPie("combinedPieChart",
      <%= raw @top5.map(&:first).to_json %>,
      <%= raw @top5.map { |_, v| v.round(2).to_f }.to_json %>
    );
    drawPie("a1a3-pie",
      <%= raw @a1a3_top.map(&:first).to_json %>,
      <%= raw @a1a3_top.map { |_, v| v.round(2).to_f }.to_json %>
    );
    drawPie("a4a5-pie",
      <%= raw @a4a5_top.map(&:first).to_json %>,
      <%= raw @a4a5_top.map { |_, v| v.round(2).to_f }.to_json %>
    );
    drawPie("stage-comparison-pie",
      ["A1~A3 階段", "A4~A5 階段"],
      [<%= @a1a3_total.round(2).to_f %>, <%= @a4a5_total.round(2).to_f %>]
    );

    const canvas = document.getElementById("combinedPieChart");
    const exportBtn = document.getElementById("exportPdfButton");

    if (canvas && exportBtn) {
      exportBtn.addEventListener("click", () => {
        const imageData = canvas.toDataURL("image/png");

        fetch("/reports/upload_chart", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify({
            project_id: "<%= @project.id %>",
            image_data: imageData
          })
        }).then((res) => {
          if (res.ok) {
            window.location.href = "<%= export_project_path(@project, format: :pdf) %>";
          } else {
            alert("圖表上傳失敗，請稍後重試。");
          }
        }).catch(() => {
          alert("匯出請求失敗，請檢查網路連線。");
        });
      }, { once: true });
    }
  };

  document.addEventListener("turbo:load", setupProjectCharts);
  document.addEventListener("turbo:frame-load", setupProjectCharts);
  if (document.readyState === "interactive" || document.readyState === "complete") {
    setupProjectCharts();
  }
</script>

<%= link_to "返回專案材料頁", project_material_usages_path(@project, stage: "A1-A3"), class: "btn btn-outline-secondary me-2" %>
<div class="export-button" style="margin-top: 20px;">
  <button id="exportPdfButton" class="btn btn-success">匯出完整報告</button>
</div>
