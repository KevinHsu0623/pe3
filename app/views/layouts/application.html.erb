<!DOCTYPE html>
<html>
  <head>
    <title>PE3 工程碳排估算平台</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <%= stylesheet_link_tag "application", media: "all" %>
    <!-- 只保留這一行 JS；需在 app/javascript/application.js 內 import Turbo -->
    <%= javascript_include_tag "application", type: "module", "data-turbo-track": "reload" %>
  </head>

  <body class="container py-4">
    <header class="mb-4">
      <nav>
        <ul class="nav nav-pills gap-2">
          <% if user_signed_in? %>
            <li class="nav-item">
              <%= link_to "首頁", root_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <!-- 用 Turbo 的 DELETE，維持與其他連結同外觀 -->
              <%= link_to "登出",
                          destroy_user_session_path,
                          class: "nav-link",
                          data: { turbo_method: :delete, turbo_confirm: "確定要登出嗎？" } %>
            </li>
          <% else %>
            <li class="nav-item">
              <%= link_to "登入", new_user_session_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "註冊", new_user_registration_path, class: "nav-link" %>
            </li>
          <% end %>
        </ul>
      </nav>
    </header>

    <main>
      <%= yield %>
    </main>

    <footer class="text-center text-muted mt-5 mb-3 small">
      &copy; <%= Time.current.year %> PE3 工程碳排平台 · 國立臺北科技大學水環境研究中心 WERC
    </footer>
  </body>
</html>
